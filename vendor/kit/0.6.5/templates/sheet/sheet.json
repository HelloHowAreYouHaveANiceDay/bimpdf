{
  "name": "sheet",
  "rev": 3,
  "note": "Broadsheet drawing sheet (Revit). Source of truth for the layout: inches, origin at the sheet's bottom-left. Colours are kit colour TOKEN names (DESIGN.md colors:, light theme: a sheet is paper) or 'spot' (the property's spot, DESIGN.md spots:), faces are kit roles (serif 700, sans 400 / 600, mono 400). scripts/gen-sheet.mjs resolves this file per property into sheet.<property>.json (concrete fonts + rgb), which the Revit scripts read. Edit here, run `pnpm --filter @bim-pdf/ui-kit gen`, never edit a sheet.<property>.json.",
  "sheet": { "size_in": [36, 24], "family_template": "D - 36 x 24.rft", "media_box_pt": [2592, 1728] },
  "border_in": 0.5,
  "strip": { "x0": 30.0, "x1": 35.5, "pad": 0.25 },
  "rows": [
    { "id": "brand",   "y0": 20.50, "y1": 23.50 },
    { "id": "project", "y0": 18.75, "y1": 20.50, "label": "PROJECT" },
    { "id": "site",    "y0": 16.75, "y1": 18.75, "label": "SITE" },
    { "id": "data",    "y0": 7.25,  "y1": 16.75, "label": "SITE + ZONING DATA" },
    { "id": "meta",    "y0": 5.75,  "y1": 7.25,  "split": 32.75, "label": "DATE", "label2": "SCALE" },
    { "id": "note",    "y0": 4.25,  "y1": 5.75 },
    { "id": "sheet",   "y0": 0.50,  "y1": 4.25,  "label": "SHEET" }
  ],
  "faces": {
    "serif-700": { "role": "serif", "weight": 700, "revit": { "font": "Georgia", "bold": true, "cap": 0.692 } },
    "sans-400":  { "role": "sans",  "weight": 400, "revit": { "font": "Segoe UI", "bold": false, "cap": 0.70 } },
    "sans-600":  { "role": "sans",  "weight": 600, "revit": { "font": "Segoe UI Semibold", "bold": false, "cap": 0.70 } },
    "mono-400":  { "role": "mono",  "weight": 400, "revit": { "font": "Consolas", "bold": false, "cap": 0.64 } }
  },
  "styles": {
    "label":      { "face": "sans-600",  "ink": "muted", "pt": 8,  "use": "field label (kicker, as the kit kicker): uppercase, small, grey, sans 600" },
    "wordmark":   { "face": "serif-700", "ink": "spot",  "pt": 56, "use": "the property's wordmark: the ONLY spot-coloured text" },
    "url":        { "face": "mono-400",  "ink": "text",  "pt": 15, "use": "the property's URL" },
    "tagline":    { "face": "sans-400",  "ink": "muted", "pt": 10, "use": "one line under the wordmark" },
    "disclaimer": { "face": "sans-600",  "ink": "text",  "pt": 9,  "use": "status / disclaimer words" },
    "headline":   { "face": "serif-700", "ink": "text",  "pt": 20, "use": "project name" },
    "value":      { "face": "sans-400",  "ink": "text",  "pt": 14, "use": "site, sheet name" },
    "data":       { "face": "mono-400",  "ink": "text",  "pt": 15, "use": "data block: figures and codes" },
    "figure":     { "face": "mono-400",  "ink": "text",  "pt": 16, "use": "date, scale" },
    "number":     { "face": "sans-600",  "ink": "text",  "pt": 66, "use": "sheet number" }
  },
  "static": [
    { "row": "brand", "style": "wordmark",   "dy": 0.30, "text": "{wordmark}" },
    { "row": "brand", "style": "url",        "dy": 1.45, "text": "{url}" },
    { "row": "brand", "style": "tagline",    "dy": 2.00, "text": "{tagline}" },
    { "row": "note",  "style": "disclaimer", "dy": 0.25, "text": "{disclaimer}" }
  ],
  "fields": {
    "project": { "row": "project", "style": "headline", "dy": 0.45 },
    "site":    { "row": "site",    "style": "value",    "dy": 0.45 },
    "data":    { "row": "data",    "style": "data",     "dy": 0.45 },
    "date":    { "row": "meta",    "style": "figure",   "dy": 0.45, "col": 0 },
    "scale":   { "row": "meta",    "style": "figure",   "dy": 0.45, "col": 1 },
    "name":    { "row": "sheet",   "style": "value",    "dy": 0.45 },
    "number":  { "row": "sheet",   "style": "number",   "dy": 1.55 }
  },
  "properties": {
    "bimcli": {
      "wordmark": "bim-cli",
      "url": "bimcli.com",
      "tagline": "Drawn by an AI agent driving bim-cli. Every value on this sheet comes from the run that made it.",
      "disclaimer": "FEASIBILITY STUDY. NOT FOR CONSTRUCTION. Public data as retrieved on the date shown; verify before use.",
      "family": "bimcli-Sheet-ArchD",
      "template_file": "bimcli-Sheet.rte",
      "type_prefix": "bimcli-",
      "project_info": { "name": "bim-cli feasibility study", "organization": "bim-cli", "number": "BIMCLI", "status": "Feasibility" }
    }
  }
}
